#!/bin/bash
# Mirage dev pre-push hook: auto-run local CI before push (instead of quota-disabled GitHub Actions).
# Enable once:  git config core.hooksPath .githooks
# Afterwards, before every git push it auto-runs pytest + ruff + mypy + benchmark self-check; if red, it blocks the push.
exec bash "$(git rev-parse --show-toplevel)/scripts/ci.sh"
